# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by docker-compose and all backend services.
# Copy to .env and fill in real values before running `docker-compose up`.
# ─────────────────────────────────────────────────────────────────────────────

# OAuth client credentials (from your 0account app dashboard).
# NEXT_PUBLIC_ prefix makes this available in the browser bundle too (for the
# The backends receive it as ZERO_CLIENT_ID via docker-compose.
NEXT_PUBLIC_CLIENT_ID=your-client-id

# IMPORTANT: wrap secrets in single quotes if they contain $ characters
# (e.g. 0account_sec_$argon2id$... format). Docker Compose's env_file parser
# (godotenv) expands unquoted $VAR sequences to empty string, silently
# corrupting the secret. Single quotes prevent this.
ZERO_CLIENT_SECRET='your-client-secret'

# Auth.js signing secret — generate with: npx auth secret
# Same rule applies: single-quote if the value contains $.
AUTH_SECRET='your-auth-secret'

# Session secret for the Express backend examples
SESSION_SECRET=your-session-secret

# ── Local development defaults ────────────────────────────────────────────────
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback

# Register these callback/redirect URIs in your 0account dashboard:
#   OIDC/Auth.js: http://localhost:3000/api/auth/callback/0account
#   Passport.js:  http://localhost:8081/auth/callback
#   openid-client http://localhost:8082/auth/callback
#   go-oidc:      http://localhost:8083/auth/callback
#   Goth:         http://localhost:8084/auth/callback

# ── Cloudflare tunnel (or any public domain) ──────────────────────────────────
# Uncomment and set these when running behind a tunnel / in production.
# The backend URLs are baked into the showcase browser bundle at build time,
# so the showcase must be rebuilt after changing them (docker compose up --build).
#
# APP_URL=https://showcase.0account.com
# NEXT_PUBLIC_APP_URL=https://showcase.0account.com
# NEXT_PUBLIC_REDIRECT_URI=https://showcase.0account.com/auth/callback
#
# NEXT_PUBLIC_PASSPORT_URL=https://passport-js.0account.com
# NEXT_PUBLIC_OPENID_CLIENT_URL=https://openid-client.0account.com
# NEXT_PUBLIC_GO_OIDC_URL=https://go-oidc.0account.com
# NEXT_PUBLIC_GO_GOTH_URL=https://goth.0account.com
#
# PASSPORT_REDIRECT_URI=https://passport-js.0account.com/auth/callback
# OPENID_CLIENT_REDIRECT_URI=https://openid-client.0account.com/auth/callback
# GO_OIDC_REDIRECT_URI=https://go-oidc.0account.com/auth/callback
# GO_GOTH_REDIRECT_URI=https://goth.0account.com/auth/callback
#
# Register all of the above URLs in your 0account dashboard too.

