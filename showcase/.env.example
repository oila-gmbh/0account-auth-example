# 0account Auth Example — Showcase

# Required for OIDC flow (Auth.js)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Session secret — shared by all backends
# Generate: openssl rand -hex 32
SESSION_SECRET=your-session-secret

# Generate with: npx auth secret
AUTH_SECRET=your-random-secret

# Required for widget flow (app-id equals your OAuth client_id)
NEXT_PUBLIC_CLIENT_ID=your-client-id

# The redirect_uri registered in your 0account app dashboard.
# For local development: http://localhost:3000/auth/callback
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback

# URLs for OIDC backend examples (defaults match docker-compose ports)
# NEXT_PUBLIC_PASSPORT_URL=http://localhost:8081
# NEXT_PUBLIC_OPENID_CLIENT_URL=http://localhost:8082
# NEXT_PUBLIC_GO_OIDC_URL=http://localhost:8083
# NEXT_PUBLIC_GO_GOTH_URL=http://localhost:8084

# URLs for widget backend examples (defaults match docker-compose ports)
# Register http://localhost:8085/ and http://localhost:8086/ as redirect_uris
# NEXT_PUBLIC_GO_WIDGET_URL=http://localhost:8085
# NEXT_PUBLIC_NODEJS_WIDGET_URL=http://localhost:8086

# Used for absolute URLs (optional — defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
